node_modules
dist
*.local
.env
.env.*
!.env.example
.DS_Store

# Backend build outputs & IDE state
backend/**/bin/
backend/**/obj/
backend/.vs/
# Per-machine settings (connection strings, admin users) — never committed
appsettings.*.local.json

# Release artifacts produced by scripts/release.ps1
releases/

# Offline kit: the npm cache IS committed (vendor/npm-cache) so the front
# builds without internet; only its logs and the (huge) NuGet mirror are not.
vendor/npm-cache/_logs/
vendor/nuget/
